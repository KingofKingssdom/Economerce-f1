{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://huystore.runasp.net/api/:path*"
    },
    {
      "source": "/Images/:path*",
      "destination": "http://huystore.runasp.net/Images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
